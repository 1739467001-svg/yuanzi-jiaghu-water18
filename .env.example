# Optional. Without these values, the app uses explicitly labelled local demo replies.
ATOM_LLM_BASE_URL=https://api.openai.com/v1
ATOM_LLM_API_KEY=
ATOM_LLM_MODEL=
# Maximum requests per local server session (restart resets the counter).
ATOM_SESSION_LIMIT=100
# 模型单价（每 1K token，与 ATOM_DAILY_BUDGET 同币种）；不配置则按 token 计数
ATOM_LLM_PRICE_IN=0.01
ATOM_LLM_PRICE_OUT=0.03
# 每日预算（金额或 token 计数，取决于是否配置单价）
ATOM_DAILY_BUDGET=50
